node_modules/
dist/
coverage/
*.tsbuildinfo

# Local secrets and local state — never committed.
.env
.env.local
*.db
*.db-wal
*.db-shm
data/

.DS_Store

# local-only vitest shim config (node:sqlite stand-in)
vitest.local.config.ts

# The publishable package: only its manifest is authored. Everything else under
# npm/ is copied or bundled by scripts/build-npm.mjs, so committing it would
# create a second copy of the source that can silently disagree with the first.
npm/*.tgz
npm/schema.sql
npm/console.html
npm/README.md
npm/LICENSE
npm/examples/

# Planning and working notes. These are mine, not the project's: the handoff in
# particular carries personal details that have no business in a public repo,
# and one `git add -A` is all it would take.
HANDOFF_*.md
BUILD_ORDER.md
PROMPTS.md
what_broke.txt

# Scratch ledger for scripts/demo.mjs and console rehearsals.
.demo/
