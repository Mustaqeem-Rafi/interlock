{
  "name": "interlock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build",
    "lint": "eslint . && node scripts/check-thin.mjs",
    "check:thin": "node scripts/check-thin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "chaos:matrix": "pnpm run build && node packages/chaos/dist/matrix.js",
    "bench": "pnpm run build && node packages/bench/dist/cli.js",
    "results": "node scripts/compose-results.mjs",
    "interlock": "node packages/gate/dist/bin/interlock-mcp.js",
    "mandate:init": "pnpm run build && node packages/gate/dist/bin/interlock-init.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
