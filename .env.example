# Copy to .env. Every required var is validated by packages/core/src/env.ts at
# boot; a missing or empty one crashes the process rather than degrading.

# Where the intent/audit ledger lives. Required.
# The exactly-once engine opens this with PRAGMA synchronous = FULL (I2).
INTERLOCK_DB_PATH=./data/interlock.db

# Bearer token for the operator console / HTTP surface. Required, >= 16 chars.
INTERLOCK_CONSOLE_TOKEN=replace-me-with-32-random-bytes

# Which rail the gate talks to: "mock" (default, used by the chaos matrix and
# the scenario suite) or "razorpay" (live API).
INTERLOCK_RAIL=mock

# Required only when INTERLOCK_RAIL=razorpay. Leave blank for mock runs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
